{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.orbio/contracts/feed.schema.json",
  "title": "Sentinel gateway feed event",
  "description": "Frozen append-only Day 1 gateway ledger. raw retains the verbatim provider response available to Sentinel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "seq", "event", "actor", "key_id", "orbio_balance", "orbio_spent", "key_state", "reason", "threshold", "raw"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "seq": { "type": "integer", "minimum": 1 },
    "event": { "type": "string", "enum": ["BALANCE_READ", "KEY_CREATED", "INFERENCE_CALL", "KEY_STATUS_READ", "KEY_REVOKED", "RECONCILIATION_FAILED"] },
    "actor": { "const": "sentinel" },
    "key_id": { "type": ["string", "null"] },
    "orbio_balance": { "type": ["number", "null"] },
    "orbio_spent": { "type": ["number", "null"] },
    "key_state": { "type": ["string", "null"], "enum": ["active", "revoked", null] },
    "reason": { "type": "string" },
    "threshold": { "type": ["number", "null"] },
    "raw": { "type": "object" }
  }
}
