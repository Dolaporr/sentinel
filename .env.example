# Default is mock: no real Orbio credits are claimed or spent.
ORBIO_BACKEND=mock

# Set only after Orbio OAuth is live and MCP_SURFACE.md has been re-verified.
ORBIO_MCP_URL=https://www.orbio.so/api/mcp

# Used only by the live inference adapter. Never commit a real key.
OPENROUTER_API_KEY=

# Used by the local Sentinel proxy. The proxy also accepts OPENROUTER_API_KEY
# for compatibility, but new Orbio gateway setups should use this name.
ORBIO_API_KEY=

# Optional mock failure injection (one at a time):
# stale_balance | tool_latency_30s | revoke_midway_fail | spend_telemetry_lag
MOCK_FAILURE_MODE=
